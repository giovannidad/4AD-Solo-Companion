{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giovannidad.github.io/4AD-Solo-Companion/assets/moduli/modulo-avventura.schema.json",
  "title": "Avventura scritta per Four Against Darkness – tavolo da gioco",
  "description": "Struttura del file 4ad-avventura (versione 1). Controlla solo la forma: i controlli sulla mappa (sovrapposizioni, porte, raggiungibilità) li fa tools/valida-modulo.js. Vedi docs/MODULI.md.",
  "type": "object",
  "required": ["formato", "versione", "nome", "stanze"],
  "properties": {
    "$schema": { "type": "string" },
    "formato": { "const": "4ad-avventura" },
    "versione": { "const": 1 },
    "nome": { "type": "string", "minLength": 1, "maxLength": 60 },
    "autore": { "type": "string", "maxLength": 4000 },
    "licenza": { "type": "string", "maxLength": 4000 },
    "lingua": { "type": "string" },
    "descrizione": { "type": "string", "maxLength": 4000 },
    "introduzione": { "type": "string", "maxLength": 4000 },
    "conclusione": { "type": "string", "maxLength": 4000 },
    "obiettivo": { "type": "string", "maxLength": 4000, "description": "Che cosa deve ottenere il gruppo: si mostra insieme all'introduzione quando l'avventura inizia." },
    "serie": { "type": "object", "required": ["id", "numero", "di"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" }, "numero": { "type": "integer", "minimum": 1 }, "di": { "type": "integer", "minimum": 1 } }, "additionalProperties": false, "description": "Capitolo n di una campagna a più avventure." },
    "introduzioneSe": { "type": "object", "description": "Testi aggiuntivi dell'introduzione secondo il finale scelto in un capitolo precedente: chiave \"capitolo:id-finale\".", "additionalProperties": { "type": "string" } },
    "finali": { "type": "array", "minItems": 2, "maxItems": 6, "description": "Finali a scelta: alla conclusione con successo il giocatore ne sceglie uno; la scelta si ricorda per i capitoli successivi.", "items": { "type": "object", "required": ["id", "nome", "testo"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" }, "nome": { "type": "string", "maxLength": 60 }, "scelta": { "type": "string" }, "testo": { "type": "string" } }, "additionalProperties": false } },
    "livello": { "$ref": "#/$defs/intervallo", "description": "Livello consigliato dei personaggi (1-30)." },
    "eroi": { "$ref": "#/$defs/intervalloEroi", "description": "Numero consigliato di personaggi." },
    "set": { "enum": ["base", "coboldi", "acque", "diabolici", "caos", "abisso", "aldila", "profondita"], "default": "base" },
    "fine": { "enum": ["boss", "libera"], "default": "boss" },
    "stanze": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "$ref": "#/$defs/stanza" } },
    "porte": { "type": "array", "items": { "$ref": "#/$defs/porta" } }
  },
  "additionalProperties": false,
  "$defs": {
    "intero": { "type": "integer" },
    "intervallo": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 30 }, "max": { "type": "integer", "minimum": 1, "maximum": 30 } }, "additionalProperties": false },
    "intervalloEroi": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 12 }, "max": { "type": "integer", "minimum": 1, "maximum": 12 } }, "additionalProperties": false },
    "quantita": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 99 }, { "type": "string", "pattern": "^\\d{0,2}[dD]\\d{1,2}([+-]\\d{1,3})?$" }] },
    "testo": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "stanza": {
      "type": "object",
      "required": ["id", "nome"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
        "nome": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tipo": { "enum": ["ingresso", "stanza", "corridoio"], "default": "stanza" },
        "rettangolo": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "integer", "minimum": 1, "maximum": 60 }, { "type": "integer", "minimum": 1, "maximum": 60 }], "items": false, "minItems": 4 },
        "celle": { "type": "array", "minItems": 1, "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "items": false, "minItems": 2 } },
        "testo": { "$ref": "#/$defs/testo" },
        "contenuto": { "oneOf": [{ "type": "array", "items": { "$ref": "#/$defs/elemento" } }, { "$ref": "#/$defs/elemento" }] }
      },
      "oneOf": [{ "required": ["rettangolo"] }, { "required": ["celle"] }],
      "additionalProperties": false
    },
    "porta": {
      "type": "object",
      "required": ["da", "a", "x", "y", "lato"],
      "properties": {
        "da": { "type": "string" }, "a": { "type": "string" },
        "x": { "type": "integer" }, "y": { "type": "integer" },
        "lato": { "enum": ["n", "s", "e", "o"] },
        "tipo": { "enum": ["normale", "segreta"], "default": "normale" },
        "nota": { "$ref": "#/$defs/testo" }
      },
      "additionalProperties": false
    },
    "elemento": {
      "type": "object",
      "required": ["tipo"],
      "properties": { "tipo": { "enum": ["vuota", "testo", "mostri", "tesoro", "trappola", "caratteristica", "evento"] } },
      "allOf": [
        { "if": { "properties": { "tipo": { "const": "testo" } } }, "then": { "required": ["testo"] } },
        { "if": { "properties": { "tipo": { "const": "tesoro" } } }, "then": { "anyOf": [{ "required": ["tira"] }, { "required": ["fisso"] }], "properties": { "tipo": true, "tira": { "type": "boolean" }, "mod": { "type": "integer", "minimum": -5, "maximum": 5 }, "fisso": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oggetto" } } }, "additionalProperties": false } },
        { "if": { "properties": { "tipo": { "const": "mostri" } } }, "then": { "$ref": "#/$defs/mostri" } },
        { "if": { "properties": { "tipo": { "const": "trappola" } } }, "then": { "properties": { "tipo": true, "tira": { "type": "boolean" }, "modello": { "enum": ["Botola", "Dardo", "Gas velenoso", "Lance", "Masso gigante", "Tagliola"] }, "nome": { "type": "string" }, "testo": { "$ref": "#/$defs/testo" }, "liv": { "type": "integer", "minimum": 1, "maximum": 30 } }, "additionalProperties": false } },
        { "if": { "properties": { "tipo": { "enum": ["caratteristica", "evento"] } } }, "then": { "anyOf": [{ "required": ["tira"] }, { "required": ["testo"] }], "properties": { "tipo": true, "tira": { "type": "boolean" }, "nome": { "type": "string" }, "testo": { "$ref": "#/$defs/testo" } }, "additionalProperties": false } }
      ]
    },
    "oggetto": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["oro", "gemma", "gioiello", "oggetto", "magico", "pergamena", "arma-magica", "armatura-magica"] },
        "valore": { "type": "integer", "minimum": 1 },
        "testo": { "$ref": "#/$defs/testo" },
        "nome": { "type": "string" },
        "bonusArma": { "type": "integer", "minimum": 1, "maximum": 5 },
        "bonusDifesa": { "type": "integer", "minimum": 1, "maximum": 5 },
        "armaTipo": { "type": "string" }, "armaturaTipo": { "type": "string" },
        "cariche": { "type": "integer", "minimum": 1 },
        "incantesimo": { "type": "string" },
        "solo": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "mostri": {
      "properties": {
        "tipo": true,
        "tabella": { "type": "string" }, "id": { "type": "string" },
        "nome": { "type": "string", "minLength": 1, "maxLength": 60 },
        "liv": { "type": "integer", "minimum": 1, "maximum": 40 },
        "att": { "type": "integer", "minimum": 1, "maximum": 10 },
        "pv": { "type": "integer", "minimum": 1, "maximum": 200 },
        "quantita": { "$ref": "#/$defs/quantita" },
        "maggiore": { "type": "boolean" },
        "finale": { "type": "boolean" },
        "mor": { "oneOf": [{ "type": "integer" }, { "const": "NO" }] },
        "tes": { "oneOf": [{ "type": "integer" }, { "enum": ["NO", "x2"] }] },
        "xp": { "type": "boolean" },
        "tag": { "type": "array", "items": { "type": "string" } },
        "note": { "$ref": "#/$defs/testo" },
        "reazioni": { "type": "array", "minItems": 1, "items": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1, "maximum": 6 }, { "type": "integer", "minimum": 1, "maximum": 6 }, { "enum": ["combatte", "combatte-sempre", "fugge", "fugge-inf", "morte", "corruzione", "dorme", "pacifico", "amichevole"] }], "minItems": 3 } },
        "immuneIncantesimi": { "type": "array", "items": { "type": "string" } },
        "immuneContundenti": { "type": "boolean" }, "contundentePiu": { "type": "boolean" }, "orda": { "type": "boolean" }, "dissangua": { "type": "boolean" }, "attPerBersaglio": { "type": "boolean" },
        "livPrimoTurno": { "type": "integer" }, "livDifesaFerito": { "type": "integer" }, "danno": { "type": "integer" }
      },
      "oneOf": [
        { "required": ["tabella", "id"] },
        { "required": ["nome", "liv", "att", "pv"] }
      ],
      "additionalProperties": false
    }
  }
}
